// lib/payloadBuilder.js

const estTok = (s = '') => Math.ceil((s.length || 0) / 4);

function countMsgTokens(m) {
  if (Array.isArray(m.content)) {
    const text = m.content.filter(p => p.type === 'text').map(p => p.text).join('\n');
    const imgs = m.content.filter(p => p.type === 'image_url').length;
    return estTok(text) + imgs * 150; // rough overhead per image reference
  }
  return estTok(m.content || '');
}

// Build payload with ONLY system + summary + new message.
// (No recent messages — the summary replaces them.)
export function buildPayload({ thread, newMsg, keepRecent = 40, tokenCap = 8000 }) {
  const sys = thread.system ? [{ role: 'system', content: thread.system }] : [];

  // ✅ Put the conversation summary as a system message so models treat it as context.
  const sum = thread.summary
    ? [{ role: 'system', content: `Context summary:\n${thread.summary}` }]
    : [];

  // Final shape: [system?, summary?, newMsg]
  let payload = [...sys, ...sum, newMsg];

  const total = (msgs) => msgs.reduce((n, m) => n + countMsgTokens(m), 0);
  let tokensBefore = total(payload);

  // Budget guardrail: if we somehow exceed budget, drop the summary first
  if (tokensBefore > tokenCap && sum.length) {
    payload = [...sys, newMsg];
    tokensBefore = total(payload);
  }

  // If still over (very large user input), just log. Upstream input validation already caps length.
  if (tokensBefore > tokenCap) {
    console.log(`⚠️ Still over token budget after dropping summary: ${tokensBefore}/${tokenCap}. Proceeding.`);
  }

  // Debug: Show what we're sending to AI
  if (__DEV__) {
    console.log('📤 SENDING TO AI:');
    console.log('• Payload message count:', payload.length);
    console.log('• Total tokens:', tokensBefore);
    console.log('• Messages:');
    payload.forEach((msg, i) => {
      const content = typeof msg.content === 'string' ? msg.content : 
                     Array.isArray(msg.content) ? `[${msg.content.length} parts]` : 
                     'unknown';
      const preview = typeof content === 'string' ? 
                     (content.length > 100 ? content.substring(0, 100) + '...' : content) :
                     content;
      console.log(`  ${i + 1}. [${msg.role}] ${preview}`);
    });
    
    // Show full context for each message
    console.log('📋 FULL CONTEXT BEING SENT:');
    payload.forEach((msg, i) => {
      console.log(`\n--- MESSAGE ${i + 1}: [${msg.role.toUpperCase()}] ---`);
      if (typeof msg.content === 'string') {
        console.log(msg.content);
      } else if (Array.isArray(msg.content)) {
        msg.content.forEach((part, j) => {
          console.log(`Part ${j + 1} [${part.type}]:`, part.text || part.image_url?.url || 'unknown');
        });
      } else {
        console.log('Unknown content type:', msg.content);
      }
      console.log('--- END MESSAGE ---\n');
    });
  }

  return payload;
}

// Helper to check if payload needs summary update
export function needsSummaryUpdate(thread) {
  const { shouldUpdateSummary } = require('./summaryBuilder');
  return shouldUpdateSummary(thread);
}

// Helper to get payload size for debugging
export function getPayloadSize(payload) {
  return payload.reduce((n, m) => n + countMsgTokens(m), 0);
}